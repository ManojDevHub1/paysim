{
  "name": "@paysim/server",
  "version": "1.0.0",
  "license": "MIT",
  "description": "PAYSIM local HTTP server and simulation engine host",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paysim/contracts": "*",
    "@paysim/crypto": "*",
    "@paysim/domain": "*",
    "@paysim/shared": "*",
    "@paysim/storage-memory": "*",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
